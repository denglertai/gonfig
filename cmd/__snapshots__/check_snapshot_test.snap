[TestCheckSnapshots/xml_file - 1]
environment:
SNAP_CHECK_PORT="8080"
SNAP_CHECK_USER="app"

server.xml:
<server port="${SNAP_CHECK_PORT | to_int}">
  ${SNAP_CHECK_NAME}
  <datasource url="${SNAP_CHECK_URL}">
    <user>${SNAP_CHECK_USER}</user>
    <password><![CDATA[${SNAP_CHECK_PASSWORD}]]></password>
  </datasource>
</server>

$ gonfig config check -f server.xml
server.xml: 5 entries with placeholders
  /server@port
    SNAP_CHECK_PORT          set
  /server
    SNAP_CHECK_NAME          missing
  /server/datasource@url
    SNAP_CHECK_URL           missing
  /server/datasource/user
    SNAP_CHECK_USER          set
  /server/datasource/password
    SNAP_CHECK_PASSWORD      missing
3 missing variables, 0 errors
Error: check failed: 3 missing variables, 0 errors

---

[TestCheckSnapshots/plain_text_file - 1]
environment:
SNAP_CHECK_HOST="db"

entrypoint.sh:
#!/bin/sh
export DB_URL="postgres://${SNAP_CHECK_HOST}:5432/app"
exec app --user '${SNAP_CHECK_USER | required}'

$ gonfig config check -f entrypoint.sh -t plain
entrypoint.sh: 2 entries with placeholders
  1
    SNAP_CHECK_HOST          set
  2
    SNAP_CHECK_USER          missing
    error: filter required: the value is empty or the environment variable is not set
1 missing variable, 1 error
Error: check failed: 1 missing variable, 1 error

