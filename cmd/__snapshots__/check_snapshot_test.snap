[TestCheckSnapshots/diff_with_log-values - 1]
environment:
SNAP_CHECK_APPENDERS="- name: console"
SNAP_CHECK_HOST="db.internal"
SNAP_CHECK_PORT="5432"

config.yaml:
host: ${SNAP_CHECK_HOST}
port: ${SNAP_CHECK_PORT | to_int}
appenders: ${SNAP_CHECK_APPENDERS | fragment}

$ gonfig config check -f config.yaml --diff --log-values
config.yaml: 3 entries with placeholders
  host
    SNAP_CHECK_HOST          set
  port
    SNAP_CHECK_PORT          set
  appenders
    SNAP_CHECK_APPENDERS     set
0 missing variables, 0 errors
--- config.yaml
+++ config.yaml
@@ -1,3 +1,4 @@
-host: ${SNAP_CHECK_HOST}
-port: ${SNAP_CHECK_PORT | to_int}
-appenders: ${SNAP_CHECK_APPENDERS | fragment}
+host: db.internal
+port: 5432
+appenders:
+  - name: console
(exit code 0)

