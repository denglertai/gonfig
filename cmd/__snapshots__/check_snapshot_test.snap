[TestCheckSnapshots/xml_file - 1]
environment:
SNAP_CHECK_PORT="8080"
SNAP_CHECK_USER="app"

server.xml:
<server port="${SNAP_CHECK_PORT | to_int}">
  ${SNAP_CHECK_NAME}
  <datasource url="${SNAP_CHECK_URL}">
    <user>${SNAP_CHECK_USER}</user>
    <password><![CDATA[${SNAP_CHECK_PASSWORD}]]></password>
  </datasource>
</server>

$ gonfig config check -f server.xml
server.xml: 5 entries with placeholders
  /server@port
    SNAP_CHECK_PORT          set
  /server
    SNAP_CHECK_NAME          missing
  /server/datasource@url
    SNAP_CHECK_URL           missing
  /server/datasource/user
    SNAP_CHECK_USER          set
  /server/datasource/password
    SNAP_CHECK_PASSWORD      missing
3 missing variables, 0 errors
Error: check failed: 3 missing variables, 0 errors

