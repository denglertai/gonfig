SNAP_CHECK_PORT="8080"
SNAP_CHECK_RESOURCES="<datasource name=\"main\"><user>sa</user></datasource>"

server.xml:
<server port="${SNAP_CHECK_PORT}">
  <resources>${SNAP_CHECK_RESOURCES | fragment}</resources>
</server>

$ gonfig config check -f server.xml --diff
