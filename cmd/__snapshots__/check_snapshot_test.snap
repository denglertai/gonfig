[TestCheckSnapshots/diff_of_fragments - 1]
environment:
SNAP_CHECK_APPENDERS="- name: console\n  level: ${SNAP_CHECK_LEVEL | default(debug)}\n- name: file\n  path: /var/log/app.log"
SNAP_CHECK_OVERRIDES="host: db.internal\npool:\n  max: 20\n  idle: 2\nssl: true"

config.yaml:
logging:
  level: info
  appenders: ${SNAP_CHECK_APPENDERS | fragment}
database:
  host: localhost
  pool:
    max: 5
  ${SNAP_CHECK_OVERRIDES | fragment}:

$ gonfig config check -f config.yaml --diff
config.yaml: 3 entries with placeholders
  logging.appenders
    SNAP_CHECK_APPENDERS     set
  logging.appenders.0.level
    SNAP_CHECK_LEVEL         missing, default used
  database.${SNAP_CHECK_OVERRIDES | fragment}
    SNAP_CHECK_OVERRIDES     set
0 missing variables, 0 errors
--- config.yaml
+++ config.yaml
@@ -1,8 +1,13 @@
 logging:
   level: info
-  appenders: ${SNAP_CHECK_APPENDERS | fragment}
+  appenders:
+    - name: '***'
+      level: '***'
+    - name: '***'
+      path: '***'
 database:
-  host: localhost
+  host: '***'
   pool:
-    max: 5
-  ${SNAP_CHECK_OVERRIDES | fragment}:
+    max: '***'
+    idle: '***'
+  ssl: '***'
(exit code 0)

---

[TestCheckSnapshots/diff_of_fragments_in_a_json_file - 1]
environment:
SNAP_CHECK_HOSTS="a,b"
SNAP_CHECK_OVERRIDES="{\"timeout\": 30}"
SNAP_CHECK_POOL="{\"max\": 20, \"ssl\": true, \"name\": null}"

config.json:
{
  "pool": "${SNAP_CHECK_POOL | fragment}",
  "${SNAP_CHECK_OVERRIDES | fragment}": null,
  "hosts": "${SNAP_CHECK_HOSTS | split | fragment}"
}

$ gonfig config check -f config.json --diff
config.json: 3 entries with placeholders
  pool
    SNAP_CHECK_POOL          set
  ${SNAP_CHECK_OVERRIDES | fragment}
    SNAP_CHECK_OVERRIDES     set
  hosts
    SNAP_CHECK_HOSTS         set
0 missing variables, 0 errors
--- config.json
+++ config.json
@@ -1,5 +1,12 @@
 {
-  "pool": "${SNAP_CHECK_POOL | fragment}",
-  "${SNAP_CHECK_OVERRIDES | fragment}": null,
-  "hosts": "${SNAP_CHECK_HOSTS | split | fragment}"
+  "pool": {
+    "max": "***",
+    "ssl": "***",
+    "name": "***"
+  },
+  "hosts": [
+    "***",
+    "***"
+  ],
+  "timeout": "***"
 }
(exit code 0)

