[TestCheckSnapshots/diff_with_masked_values - 1]
environment:
SNAP_CHECK_HOST="db.internal"
SNAP_CHECK_PORT="eighty"
SNAP_CHECK_USER="app"

config.yaml:
database:
  host: ${SNAP_CHECK_HOST}
  port: ${SNAP_CHECK_PORT | to_int}
  url: postgres://${SNAP_CHECK_USER}@${SNAP_CHECK_HOST}/app
  password: ${SNAP_CHECK_PASWORD}
  name: static

$ gonfig config check -f config.yaml --diff
config.yaml: 4 entries with placeholders
  database.host
    SNAP_CHECK_HOST          set
  database.port
    SNAP_CHECK_PORT          set
    error: filter to_int: the value is not an integer
  database.url
    SNAP_CHECK_USER          set
    SNAP_CHECK_HOST          set
  database.password
    SNAP_CHECK_PASWORD       missing
1 missing variable, 1 error
--- config.yaml
+++ config.yaml
@@ -1,6 +1,6 @@
 database:
-  host: ${SNAP_CHECK_HOST}
+  host: '***'
   port: ${SNAP_CHECK_PORT | to_int}
-  url: postgres://${SNAP_CHECK_USER}@${SNAP_CHECK_HOST}/app
-  password: ${SNAP_CHECK_PASWORD}
+  url: postgres://***@***/app
+  password: '***'
   name: static
Error: check failed: 1 missing variable, 1 error

