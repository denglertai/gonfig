
[TestCheckSnapshots/file_without_problems - 1]
environment:
SNAP_CHECK_HOST="db.internal"
SNAP_CHECK_PORT="5432"

config.yaml:
database:
  host: ${SNAP_CHECK_HOST}
  port: ${SNAP_CHECK_PORT | to_int}
  name: static

$ gonfig config check -f config.yaml
config.yaml: 2 entries with placeholders
  database.host
    SNAP_CHECK_HOST          set
  database.port
    SNAP_CHECK_PORT          set
0 missing variables, 0 errors
(exit code 0)

---

[TestCheckSnapshots/missing,_empty_and_default_variables_with_an_error - 1]
environment:
SNAP_CHECK_PORT="eighty"
SNAP_CHECK_SCHEMA=""
SNAP_CHECK_USER="app"

config.yaml:
database:
  host: ${SNAP_CHECK_HOST | default(localhost)}
  user: ${SNAP_CHECK_USER}
  password: ${SNAP_CHECK_PASWORD}
  port: ${SNAP_CHECK_PORT | to_int}
  schema: ${SNAP_CHECK_SCHEMA}
  url: postgres://${SNAP_CHECK_USER}@${SNAP_CHECK_HOST | default(localhost)}/${SNAP_CHECK_DB}

$ gonfig config check -f config.yaml
config.yaml: 6 entries with placeholders
  database.host
    SNAP_CHECK_HOST          missing, default used
  database.user
    SNAP_CHECK_USER          set
  database.password
    SNAP_CHECK_PASWORD       missing
  database.port
    SNAP_CHECK_PORT          set
    error: filter to_int: the value is not an integer
  database.schema
    SNAP_CHECK_SCHEMA        empty
  database.url
    SNAP_CHECK_USER          set
    SNAP_CHECK_HOST          missing, default used
    SNAP_CHECK_DB            missing
2 missing variables, 1 error
Error: check failed: 2 missing variables, 1 error

---

[TestCheckSnapshots/json_output - 1]
environment:
SNAP_CHECK_PORT="eighty"

config.yaml:
password: ${SNAP_CHECK_PASWORD}
port: ${SNAP_CHECK_PORT | to_int}
host: ${SNAP_CHECK_HOST | default(localhost)}

$ gonfig config check -f config.yaml -o json
{
  "files": [
    {
      "file": "config.yaml",
      "entries": [
        {
          "path": "password",
          "variables": [
            {
              "name": "SNAP_CHECK_PASWORD",
              "status": "missing",
              "hasDefault": false
            }
          ]
        },
        {
          "path": "port",
          "variables": [
            {
              "name": "SNAP_CHECK_PORT",
              "status": "set",
              "hasDefault": false
            }
          ],
          "error": "filter to_int: the value is not an integer"
        },
        {
          "path": "host",
          "variables": [
            {
              "name": "SNAP_CHECK_HOST",
              "status": "missing",
              "hasDefault": true
            }
          ]
        }
      ],
      "missingVariables": 1,
      "errors": 1,
      "failed": true
    }
  ],
  "missingVariables": 1,
  "errors": 1,
  "failed": true
}
Error: check failed: 1 missing variable, 1 error

