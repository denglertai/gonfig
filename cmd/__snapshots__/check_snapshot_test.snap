[TestCheckSnapshots/templates - 1]
.gonfig.yaml:
templates:
  filters:
    secret:
      filters: trim | base64
  placeholders:
    db_host:
      env: SNAP_CHECK_HOST
      default: localhost
    db_url:
      value: "jdbc:postgresql://${@db_host}:${SNAP_CHECK_PORT}/app"

environment:
SNAP_CHECK_PASSWORD=" s3cret "

config.yaml:
datasource:
  url: ${@db_url}
  password: ${SNAP_CHECK_PASSWORD | @secret}

$ gonfig --config-path <dir of .gonfig.yaml> config check -f config.yaml
config.yaml: 2 entries with placeholders
  datasource.url
    SNAP_CHECK_HOST          missing, default used
    SNAP_CHECK_PORT          missing
    templates: @db_url
  datasource.password
    SNAP_CHECK_PASSWORD      set
    templates: @secret
1 missing variable, 0 errors
Error: check failed: 1 missing variable, 0 errors

