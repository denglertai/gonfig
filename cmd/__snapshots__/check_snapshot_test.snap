[TestCheckSnapshots/plain_text_file - 1]
environment:
SNAP_CHECK_HOST="db"

entrypoint.sh:
#!/bin/sh
export DB_URL="postgres://${SNAP_CHECK_HOST}:5432/app"
exec app --user '${SNAP_CHECK_USER | required}'

$ gonfig config check -f entrypoint.sh -t plain
entrypoint.sh: 2 entries with placeholders
  1
    SNAP_CHECK_HOST          set
  2
    SNAP_CHECK_USER          missing
    error: filter required: the value is empty or the environment variable is not set
1 missing variable, 1 error
Error: check failed: 1 missing variable, 1 error

