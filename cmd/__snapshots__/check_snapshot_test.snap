+++ server.xml
@@ -1,3 +1,3 @@
-<server port="${SNAP_CHECK_PORT}">
-  <resources>${SNAP_CHECK_RESOURCES | fragment}</resources>
+<server port="***">
+  <resources><datasource name="***"><user>***</user></datasource></resources>
 </server>
(exit code 0)

