[TestTemplateSnapshots/error_for_an_unknown_template_in_the_file - 1]
.gonfig.yaml:
templates:
  filters:
    clean:
      description: Trims and lowers a value
      filters: trim | lower
    secret:
      description: Trims a secret and encodes it to base64
      filters: trim | base64
  placeholders:
    db_host:
      env: DB_HOST
      default: localhost
    db_port:
      env: DB_PORT
      default: "5432"
    db_name:
      env: DB_NAME
      default: app
      filters: "@clean"
    db_url:
      description: JDBC URL of the database
      value: "jdbc:postgresql://${@db_host}:${@db_port}/${@db_name}"
    db_url_with_credentials:
      value: "${@db_url}?user=${DB_USER | url_encode}&password=${DB_PASSWORD | url_encode}"

environment:
(none)

file (config.yaml):
url: ${@db_uri}

result:
error: failed to process the value of url in config.yaml: unknown placeholder template "db_uri"
---

[TestTemplateSnapshots/error_for_invalid_templates - 1]
.gonfig.yaml:
templates:
  filters:
    secret:
      filters: trim | bas64
    loop_a:
      filters: "@loop_b"
    loop_b:
      filters: "@loop_a"
  placeholders:
    db_host:
      env: DB_HOST
      value: localhost
    db_url:
      value: "jdbc:postgresql://${@db_hots}/app"

environment:
(none)

file (config.yaml):
url: ${@db_url}

result:
error: invalid templates in config file: filter template "secret": unknown filter "bas64"
placeholder template "db_host": define either env or value, not both
placeholder template "db_url": unknown placeholder template "db_hots" in value
filter templates refer to each other in a cycle: loop_a -> loop_b -> loop_a
---
