
[TestTypedValueSnapshots/yaml - 1]
environment:
ENABLED="1"
PORT="8080"
RATIO="0.75"
WHOLE="2"
ZIP="01701"

file (config.yaml):
port: ${PORT | to_int}
quoted_port: "${PORT | to_int}" # to_int wins over quotes
ratio: ${RATIO | to_float}
whole: ${WHOLE | to_float}
enabled: ${ENABLED | to_bool}
zip: ${ZIP} # strings stay strings
url: http://localhost:${PORT | to_int}/api
${PORT | to_int}: keys are always text
list: ["${PORT | to_int}", "${ENABLED | to_bool}"]

result:
port: 8080
quoted_port: 8080 # to_int wins over quotes
ratio: 0.75
whole: 2.0
enabled: true
zip: "01701" # strings stay strings
url: http://localhost:8080/api
"8080": keys are always text
list: [8080, true]
---

[TestTypedValueSnapshots/json - 1]
environment:
ENABLED="1"
PORT="8080"
RATIO="0.75"
WHOLE="2"
ZIP="01701"

file (config.json):
{
  "port": "${PORT | to_int}",
  "ratio": "${RATIO | to_float}",
  "whole": "${WHOLE | to_float}",
  "enabled": "${ENABLED | to_bool}",
  "zip": "${ZIP}",
  "url": "http://localhost:${PORT | to_int}/api",
  "${PORT | to_int}": "keys are always text"
}

result:
{
  "port": 8080,
  "ratio": 0.75,
  "whole": 2.0,
  "enabled": true,
  "zip": "01701",
  "url": "http://localhost:8080/api",
  "8080": "keys are always text"
}
---

