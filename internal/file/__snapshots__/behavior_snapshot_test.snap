[TestTemplateSnapshots/defaults - 1]
.gonfig.yaml:
templates:
  filters:
    clean:
      description: Trims and lowers a value
      filters: trim | lower
    secret:
      description: Trims a secret and encodes it to base64
      filters: trim | base64
  placeholders:
    db_host:
      env: DB_HOST
      default: localhost
    db_port:
      env: DB_PORT
      default: "5432"
    db_name:
      env: DB_NAME
      default: app
      filters: "@clean"
    db_url:
      description: JDBC URL of the database
      value: "jdbc:postgresql://${@db_host}:${@db_port}/${@db_name}"
    db_url_with_credentials:
      value: "${@db_url}?user=${DB_USER | url_encode}&password=${DB_PASSWORD | url_encode}"

environment:
(none)

file (config.yaml):
datasource:
  host: ${@db_host}
  url: ${@db_url}
  url_ssl: ${@db_url}?ssl=true
  port: ${@db_port | to_int}

result:
datasource:
  host: localhost
  url: jdbc:postgresql://localhost:5432/app
  url_ssl: jdbc:postgresql://localhost:5432/app?ssl=true
  port: 5432
---

[TestTemplateSnapshots/environment_variables - 1]
.gonfig.yaml:
templates:
  filters:
    clean:
      description: Trims and lowers a value
      filters: trim | lower
    secret:
      description: Trims a secret and encodes it to base64
      filters: trim | base64
  placeholders:
    db_host:
      env: DB_HOST
      default: localhost
    db_port:
      env: DB_PORT
      default: "5432"
    db_name:
      env: DB_NAME
      default: app
      filters: "@clean"
    db_url:
      description: JDBC URL of the database
      value: "jdbc:postgresql://${@db_host}:${@db_port}/${@db_name}"
    db_url_with_credentials:
      value: "${@db_url}?user=${DB_USER | url_encode}&password=${DB_PASSWORD | url_encode}"

environment:
DB_HOST="db.prod"
DB_NAME=" Orders "
DB_PASSWORD="p@ss/w rd&"
DB_USER="app"

file (config.yaml):
datasource:
  url: ${@db_url_with_credentials}
  port: ${@db_port | to_int}

result:
datasource:
  url: jdbc:postgresql://db.prod:5432/orders?user=app&password=p%40ss%2Fw+rd%26
  port: 5432
---

[TestTemplateSnapshots/filter_templates - 1]
.gonfig.yaml:
templates:
  filters:
    clean:
      description: Trims and lowers a value
      filters: trim | lower
    secret:
      description: Trims a secret and encodes it to base64
      filters: trim | base64
  placeholders:
    db_host:
      env: DB_HOST
      default: localhost
    db_port:
      env: DB_PORT
      default: "5432"
    db_name:
      env: DB_NAME
      default: app
      filters: "@clean"
    db_url:
      description: JDBC URL of the database
      value: "jdbc:postgresql://${@db_host}:${@db_port}/${@db_name}"
    db_url_with_credentials:
      value: "${@db_url}?user=${DB_USER | url_encode}&password=${DB_PASSWORD | url_encode}"

environment:
NAME=" Gonfig "
PASSWORD=" s3cret "

file (config.yaml):
password: ${PASSWORD | @secret}
name: ${NAME | @clean}
chained: ${NAME | @clean | upper | @secret}

result:
password: czNjcmV0
name: gonfig
chained: R09ORklH
---

