---

[TestFragmentSnapshots/toml_key_merged_into_its_table - 1]
file (config.toml):
[database]
host = "localhost" # development
port = 5432
  pool = { size = 5 }
  "${FRAGMENT | fragment}" = "" # environment overrides

[logging]
level = "info"

FRAGMENT:
host = "db.prod" # comments of the fragment are dropped
pool = { size = 20, timeout = "${FRAGMENT_PORT}" }
'user name' = "${FRAGMENT_SECRET}"
replicas = ["db-1", "db-2"]

result:
[database]
host = "db.prod" # development
port = 5432
  pool = { size = 20, timeout = "8080" }
  'user name' = "s3cret"
  replicas = ["db-1", "db-2"] # environment overrides

[logging]
level = "info"
---

