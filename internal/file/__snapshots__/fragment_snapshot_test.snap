  "hosts": [
    "db-1",
    "db-2",
    "db-3"
  ]
}
---

[TestFragmentSnapshots/error_for_a_list_in_an_xml_file - 1]
file (config.xml):
<server><hosts>${FRAGMENT | split | fragment}</hosts></server>

FRAGMENT:
db-1,db-2

result:
