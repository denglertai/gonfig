---

[TestFragmentSnapshots/toml_value_replaced_by_an_array_of_inline_tables - 1]
file (config.toml):
# Logging configuration
[logging]
level = "info" # default level
appenders = "${FRAGMENT | fragment}" # set per environment

FRAGMENT:
[
  { type = "console" },
  { type = "file", path = "/var/log/app.log", maxSize = 100 }, # rotated daily
]

result:
# Logging configuration
[logging]
level = "info" # default level
appenders = [
  { type = "console" },
  { type = "file", path = "/var/log/app.log", maxSize = 100 }, # rotated daily
] # set per environment
---

