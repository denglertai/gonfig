[TestFragmentSnapshots/toml_empty_fragments - 1]
file (config.toml):
optional = "${FRAGMENT | fragment}"
[settings]
a = 1
  b = '${FRAGMENT | fragment}'
c = """${FRAGMENT | fragment}""" # the comment is kept

FRAGMENT:
(empty)

result:
[settings]
a = 1
# the comment is kept
---

[TestFragmentSnapshots/toml_list_from_split - 1]
file (config.toml):
hosts = "${FRAGMENT | split | trim | fragment}"
nested = { hosts = "${FRAGMENT | split | fragment}" }

FRAGMENT:
db-1, db-2

result:
hosts = ["db-1","db-2"]
nested = { hosts = ["db-1"," db-2"] }
---

[TestFragmentSnapshots/error_for_an_empty_toml_fragment_in_an_array - 1]
file (config.toml):
hosts = ["db-1", "${FRAGMENT | fragment}"]

FRAGMENT:
(empty)

result:
error: failed to insert the fragment of hosts.1 in config.toml: an empty fragment can only remove a key/value pair, not a value within an array or inline table
---

[TestFragmentSnapshots/error_for_a_toml_fragment_with_several_values - 1]
file (config.toml):
settings = "${FRAGMENT | fragment}"

FRAGMENT:
1
other = 2

result:
error: failed to insert the fragment of settings in config.toml: invalid TOML fragment: a fragment used as a value must consist of a single value
---

[TestFragmentSnapshots/error_for_an_invalid_toml_fragment - 1]
file (config.toml):
settings = "${FRAGMENT | fragment}"

FRAGMENT:
{ a = 1, a = 2 }

