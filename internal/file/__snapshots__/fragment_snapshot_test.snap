[TestFragmentSnapshots/error_for_a_toml_key_with_a_dotted_key_of_the_table - 1]
file (config.toml):
[database]
pool.size = 5
"${FRAGMENT | fragment}" = ""

FRAGMENT:
pool = { size = 20 }

result:
error: failed to insert the fragment of database.${FRAGMENT | fragment} in config.toml: the fragment and the table both define pool, one of them with dotted keys within it; a fragment used as a key in a TOML file only replaces the values of keys written the same way
---

[TestFragmentSnapshots/error_for_a_toml_key_defined_by_a_table_header - 1]
file (config.toml):
[database]
"${FRAGMENT | fragment}" = ""
[database.pool]
size = 5

FRAGMENT:
pool = { size = 20 }

result:
error: failed to write config.toml: the renamed keys or the fragments used as keys make the TOML document invalid on line 3, e.g. because a key of a fragment is also defined by a table header
---

[TestFragmentSnapshots/error_for_a_toml_key_fragment_with_a_table_header - 1]
file (config.toml):
[database]
"${FRAGMENT | fragment}" = ""

FRAGMENT:
host = "db.prod"
[pool]
size = 20

result:
error: failed to insert the fragment of database.${FRAGMENT | fragment} in config.toml: invalid TOML fragment: a fragment used as a key must consist of key/value pairs, without table headers
---

[TestFragmentSnapshots/error_for_two_toml_keys_overriding_the_same_key - 1]
file (config.toml):
host = "localhost"
"${FRAGMENT | fragment}" = ""
"${FRAGMENT | trim | fragment}" = ""

FRAGMENT:
host = "db.prod"

result:
error: failed to write config.toml: two fragments used as keys replace the value on line 1
---

[TestFragmentSnapshots/error_for_a_toml_key_with_a_value - 1]
file (config.toml):
[database]
"${FRAGMENT | fragment}" = "value"

FRAGMENT:
host = "db.prod"

result:
error: failed to insert the fragment of database.${FRAGMENT | fragment} in config.toml: a fragment used as a key in a TOML file must be the only key of a key/value pair outside inline tables, with an empty string as its value, e.g. "${X | fragment}" = ""
---

[TestFragmentSnapshots/error_for_a_toml_key_in_a_table_header - 1]
file (config.toml):
["${FRAGMENT | fragment}"]
host = "localhost"

FRAGMENT:
host = "db.prod"

result:
error: failed to insert the fragment of ${FRAGMENT | fragment} in config.toml: a fragment used as a key in a TOML file must be the only key of a key/value pair outside inline tables, with an empty string as its value, e.g. "${X | fragment}" = ""
---
